# ==============================================================================
# remote-search-work - Root Environment Template
# Copy to .env in your respective environments (DEV or PROD)
# WARNING: NEVER commit real .env files to Git!
# ==============================================================================

# Backend Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Allowed CORS origins (comma-separated). For dev: http://localhost:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Scraping refresh interval in minutes (default 10)
SCRAPER_INTERVAL_MINUTES=10
# Cache time-to-live in seconds (default 600 = 10 minutes)
CACHE_TTL_SECONDS=600

# Frontend Configuration
# Development backend URL: http://localhost:4000
# Production backend URL: https://your-backend-service.onrender.com
VITE_API_BASE_URL=http://localhost:4000
